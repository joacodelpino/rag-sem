# Única variable obligatoria: la clave de OpenAI para la generación.
OPENAI_API_KEY=

# Modelo de generación. gpt-4o-mini para desarrollo (barato); para la demo
# final se puede subir a uno mejor sin tocar código.
OPENAI_MODEL=gpt-4o-mini

# Qdrant corre en Docker, la app corre local -> localhost.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_docs

# Embeddings densos y reranker: locales en CPU vía sentence-transformers, sin
# API. Lo único que sale a internet en todo el pipeline es la generación.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
