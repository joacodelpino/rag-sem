# Única variable obligatoria: la clave de OpenAI para la generación.
OPENAI_API_KEY=

# Modelo de generación. gpt-4o-mini para desarrollo (barato); para la demo
# final se puede subir a uno mejor sin tocar código.
OPENAI_MODEL=gpt-4o-mini

# Qdrant corre en Docker, la app corre local -> localhost.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_docs

# Embeddings densos y reranker: locales en CPU vía sentence-transformers, sin
# API. Lo único que sale a internet en todo el pipeline es la generación.
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker (cross-encoder). Dos valores soportados y verificados; el costo del
# reranking crece lineal con RERANK_CANDIDATES porque el modelo corre una vez
# por par (consulta, chunk), así que el tamaño del modelo es EL factor de
# latencia del pipeline:
#
#   cross-encoder/mmarco-mMiniLMv2-L12-H384-v1   ~118M params  -> demo en vivo
#   BAAI/bge-reranker-v2-m3                      ~568M params  -> evaluación
#
# Los dos son XLM-RoBERTa multilingüe con español entre los idiomas de
# entrenamiento. Cambiar esta variable NO requiere reingestar: el reranker
# actúa sobre los candidatos ya recuperados, no sobre el índice.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Estrategia de chunking. A DIFERENCIA de RERANKER_MODEL, cambiar esta variable
# SÍ obliga a reingestar: define cómo se parte el corpus antes de indexarlo.
#
#   articulo  (default) corta por límites de artículo, y por voto en los
#             fallos. Un artículo es la unidad de respuesta de una consulta
#             jurídica; cortando cada N caracteres, la mitad de los chunks
#             empiezan a mitad de un inciso y terminan a mitad del siguiente
#             artículo.
#   fijo      ventanas solapadas de CHUNK_SIZE caracteres, el chunking del
#             walking skeleton. Queda accesible para poder correr la fila
#             "chunking fijo vs. por artículo" de la tabla de ablación.
#
# Medido sobre el corpus de 36 PDFs: 2126 chunks con "articulo" contra 2264
# con "fijo" (-6%).
CHUNK_STRATEGY=articulo

# Advertencia de versión en el system prompt. Cuando está en 1, el LLM avisa si
# el contexto es un "texto original" y la consulta parece referirse al régimen
# vigente — el caso de la LCT de 1974, cuya numeración está corrida respecto
# del texto ordenado.
#
# Existe como interruptor para poder mostrar el ANTES y el DESPUÉS de la misma
# consulta en la exposición. Apagarlo NO desarma los metadatos: la versión
# sigue estando en el encabezado de cada chunk y en la cita, así que lo que se
# aísla es el efecto del prompt. No requiere reingestar.
#
# En la app hay un checkbox que lo pisa por consulta; esto es solo el default.
ADVERTIR_VERSION=1
