# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=legal_docs_naive

# Embeddings (local, sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-m3

# LLM de generación — la interfaz en src/generate.py está detrás de estas
# tres variables para poder cambiar de proveedor sin tocar el resto del
# código. Cualquier proveedor compatible con la API de OpenAI (OpenAI,
# Groq, Together, un servidor local tipo vLLM/Ollama con endpoint OpenAI)
# funciona con solo cambiar LLM_BASE_URL.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
